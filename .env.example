# Discord Bot Token (Required)
# Get from: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# Optional: Guild/Server ID for instant slash command registration during testing.
GUILD_ID=

# License Key Configuration
KEY_PREFIX=ADAMCORP
KEY_LENGTH=5

# -------------------------------------
# Xiters Auth Configuration (https://xiter.in/api/seller/)
# -------------------------------------
API_URL=https://xiter.in/api/seller/
API_KEY=YOUR_XITERS_SELLER_KEY_HERE
KEY_MASK=ADAM CORP INTERNAL-******-******

# Optional: Specific Masks for each product
MASK_INTERNAL=ADAM CORP INTERNAL-******-******
MASK_SILENTAIM=ADAM CORP SILENT AIM-******-******
MASK_AIMKILL=ADAM CORP AIMKILL-******-******

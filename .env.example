# Discord Bot Token (Required)
# Get from: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# Optional: Guild/Server ID for instant slash command registration during testing.
# If provided, commands sync immediately on bot start instead of taking up to 1 hour globally.
GUILD_ID=

# License Key Configuration
KEY_PREFIX=ADAMCORP
KEY_LENGTH=5

# Optional: Name of the role allowed to run /generate (in addition to Administrators)
# e.g., REQUIRED_ROLE_NAME=License Manager
REQUIRED_ROLE_NAME=
